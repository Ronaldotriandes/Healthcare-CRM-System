# Database (chat-service has its own DB)
DATABASE_URL="postgresql://user:password@localhost:5432/chat_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (same secret as auth-service for local token verify)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Auth Service URL (inter-service communication)
AUTH_SERVICE_URL=http://localhost:3001

# Server
PORT=3002
NODE_ENV=development
